# ECONITH :: root ignores

# secrets / local env
.env
.env.production
*.bak

# local SSL certs
certs/
*.pem
*.key
*.crt

# python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# data / models (local artifacts)
datasets/
data/rollouts/
logs/
models/
checkpoints/
runtime/
*.sqlite
*.parquet

# node / next
dashboard/node_modules/
dashboard/.next/
dashboard/out/

# extraction artifact
_plan_extracted.txt
dist/econith_runpod_train_bundle.zip

# disposable local build/test caches
**/.next/
**/.turbo/
**/dist/
**/build/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.egg-info/
*.tsbuildinfo
*.log

# local editor/merge artifacts (keep source-controlled results)
*.orig
*.rej
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDE local settings
.vscode/
.idea/
