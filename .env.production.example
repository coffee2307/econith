# Copy to .env.production. Never commit the filled file.

# Public entrypoint. Use a real hostname for automatic HTTPS, for example:
# SITE_ADDRESS=econith.example.com
SITE_ADDRESS=:80
DEMO_USERNAME=econith
# Caddy bcrypt/argon2 hash, not a plain password.
DEMO_PASSWORD_HASH='REPLACE_WITH_CADDY_HASH'

# Generate independent random values, for example: openssl rand -hex 32
ECONITH_API_KEY=REPLACE_WITH_RANDOM_64_HEX
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC
REDIS_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC

APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=
ECONITH_JSON_LOGS=true
WORLD_SIMULATION_DEFAULT=true

# Remote OpenAI-compatible route: primary route for the defence demo.
LLM_API_KEY=REPLACE_WITH_GROQ_OR_OPENROUTER_KEY
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile
HYPOTHESIS_USE_LLM=true

# Optional local open-source fallback. Start Compose with --profile local-llm,
# then pull the model. Keep LOCAL_LLM_FIRST=false in production.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL_NAME=llama3.2:3b
LOCAL_LLM_FIRST=false
LOCAL_LLM_TIMEOUT_S=60
LOCAL_LLM_MAX_TOKENS=256
LOCAL_LLM_CONTEXT_TOKENS=2048
LOCAL_LLM_GOVERNOR_CADENCE_TICKS=180

# Data access. Keep execution on demo/testnet for the public defence build.
FRED_API_KEY=
BINANCE_DATA_API_KEY=
BINANCE_DATA_API_SECRET=
BINANCE_EXECUTION_ENV=demo
BINANCE_TESTNET=true
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Optional alerts.
ALERT_ENABLED=false
TELEGRAM_BOT_API_TOKEN=
TELEGRAM_CHAT_ID=
